{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orvo",
  "version": "0.0.0",
  "identifier": "dev.orvo.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist",
    "beforeBuildCommand": "pnpm --filter @orvo/app build"
  },
  "app": {
    "windows": [
      {
        "title": "Orvo",
        "width": 1000,
        "height": 700,
        "transparent": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
